{
  "name": "wexample/symfony-shop",
  "description": "Cart and catalog for Symfony: price snapshots, variations, schedules, stock reservation, checkout through symfony-payment",
  "type": "library",
  "license": "MIT",
  "version": "5.0.2",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyShop\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyShop\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=18.0.2",
    "wexample/symfony-money": ">=8.0.0",
    "wexample/symfony-geo": ">=8.0.2",
    "wexample/symfony-payment": ">=5.0.0",
    "wexample/symfony-media": ">=6.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "wexample/symfony-testing": ">=2.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}